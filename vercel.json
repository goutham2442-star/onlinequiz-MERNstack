{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "rootDirectory": "client",
      "framework": "vite"
    },
    "server": {
      "rootDirectory": "server"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "service": "server"
    },
    {
      "src": "/(.*)",
      "service": "client"
    }
  ]
}
